{
  "name": "ors-product-review-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/prepare-standalone.ts",
    "start": "node --env-file=.env.local .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/deploy-db.ts dev",
    "db:deploy": "tsx scripts/deploy-db.ts",
    "db:seed": "tsx prisma/seed.ts",
    "feishu:bind:developer": "tsx scripts/bind-feishu.ts developer",
    "feishu:bind:operator": "tsx scripts/bind-feishu.ts operator",
    "feishu:check": "tsx scripts/check-feishu.ts",
    "feishu:log:check": "tsx scripts/check-feishu-log.ts",
    "feishu:test": "tsx scripts/test-feishu.ts",
    "review:check": "tsx scripts/check-review.ts",
    "timezone:check": "tsx scripts/check-timezone.ts",
    "selfhost:check": "tsx scripts/check-production.ts",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "security:flow:check": "tsx scripts/check-security-hardening.ts",
    "migrate:legacy": "tsx scripts/import-legacy.ts",
    "migrate:demo": "tsx scripts/import-demo.ts",
    "storage:cleanup": "tsx scripts/cleanup-files.ts",
    "backup:create": "tsx scripts/backup-production.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "antd": "^6.5.3",
    "better-sqlite3": "12.6.2",
    "dayjs": "^1.11.13",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "read-excel-file": "^9.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "prisma": "7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.0"
  }
}
