# ORS 自托管数据目录（必须是服务器本机磁盘，不能使用 NAS/共享盘/同步目录）
ORS_DATA_DIR=
ORS_BACKUP_DIR=
# Prisma CLI 使用同一个 SQLite 文件；正斜杠兼容 Windows
DATABASE_URL=file:D:/ORS/data/ors.db

# 内网访问地址，仅用于飞书卡片跳转
NEXT_PUBLIC_APP_URL=http://192.168.1.10:3000

# 当前方案不启用内网 HTTPS，因此保持 false
ORS_COOKIE_SECURE=false

# 可选飞书通知；留空时核心流程照常运行，并保留站内通知记录
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 首次初始化管理员（运行 npm run db:seed）
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=系统管理员

# 旧数据/演示数据迁移时使用的统一临时密码，迁移后用户首次登录必须修改
MIGRATION_TEMP_PASSWORD=change-this-at-least-12-chars
# 若旧导出包含附件，指向已从 Supabase Storage 下载到本机的根目录
LEGACY_UPLOADS_DIR=D:\ORS\migration\uploads
