# demo：使用浏览器本地数据；production：启用 Supabase / Prisma / 飞书
NEXT_PUBLIC_APP_MODE=demo

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Project Settings → Database → Connection string
# 运行时使用 Transaction pooler（端口通常为 6543）
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-west-2.pooler.supabase.com:6543/postgres
# 迁移使用 Direct connection（端口通常为 5432）
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@db.your-project-ref.supabase.co:5432/postgres

# 私有附件桶
SUPABASE_STORAGE_BUCKET=product-attachments

# 飞书开放平台企业自建应用；未填写时只记录通知日志，不发送
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 部署后的公开地址，用于飞书卡片跳转
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 首次初始化管理员（只用于 npm run db:seed）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-at-least-12-chars
BOOTSTRAP_ADMIN_NAME=系统管理员
