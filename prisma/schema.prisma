generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  admin
  developer
  operator
}

enum ProductStatus {
  draft
  pending_assign
  pending_review
  approved
  rejected
  returned
  redevelop
  objection_pending
}

enum Decision {
  approved
  rejected
  returned
  redevelop
}

enum AttachmentType {
  product_image
  competitor_screenshot
  data_screenshot
  supplier_info
}

model User {
  id                 String            @id @default(uuid())
  name               String
  loginName          String            @unique @map("login_name")
  passwordHash       String            @map("password_hash")
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  passwordChangedAt  DateTime?         @map("password_changed_at")
  role               Role
  feishuUserId       String?           @map("feishu_user_id")
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  submissions        Product[]         @relation("Submitter")
  assignments        Product[]         @relation("Reviewer")
  reviews            ReviewRound[]
  objections         Objection[]
  auditLogs          AuditLog[]
  uploads            Attachment[]
  notifications      NotificationLog[]
  sessions           Session[]

  @@map("users")
}

model Product {
  id                        String        @id @default(uuid())
  code                      String        @unique
  name                      String
  category                  String?
  sourceUrl                 String?       @map("source_url")
  expectedPrice             Decimal?      @map("expected_price")
  notes                     String?
  competitorLink            String?       @map("competitor_link")
  competitorAsins           String?       @map("competitor_asins")
  coreKeyword               String?       @map("core_keyword")
  priceRange                String?       @map("price_range")
  topCompetitorLink         String?       @map("top_competitor_link")
  seasonality               String?
  usageScenario             String?       @map("usage_scenario")
  iterationPlan             String?       @map("iteration_plan")
  targetAudience            String?       @map("target_audience")
  certification             String?
  patentStatus              String?       @map("patent_status")
  trademarkStatus           String?       @map("trademark_status")
  competitorReviewsAnalysis String?       @map("competitor_reviews_analysis")
  visualUpgradeDirection    String?       @map("visual_upgrade_direction")
  copyrightCheck            String?       @map("copyright_check")
  troCheck                  String?       @map("tro_check")
  phraseTrademarkCheck      String?       @map("phrase_trademark_check")
  packaging                 String?
  supplyChainAdvantage      String?       @map("supply_chain_advantage")
  suggestedQuantity         Int?          @map("suggested_quantity")
  suggestedPrice            Decimal?      @map("suggested_price")
  minPrice                  Decimal?      @map("min_price")
  productCostCny            Decimal?      @map("product_cost_cny")
  supplierName              String?       @map("supplier_name")
  moq                       Int?
  unitPrice                 String?       @map("unit_price")
  productionTime            String?       @map("production_time")
  supplierLink              String?       @map("supplier_link")
  supplierRemark            String?       @map("supplier_remark")
  lengthCm                  Decimal?      @map("length_cm")
  widthCm                   Decimal?      @map("width_cm")
  heightCm                  Decimal?      @map("height_cm")
  weightG                   Decimal?      @map("weight_g")
  volumetricWeightKg        Decimal?      @map("volumetric_weight_kg")
  billingWeightLb           Decimal?      @map("billing_weight_lb")
  fbaSizeTier               String?       @map("fba_size_tier")
  fbaFee                    Decimal?      @map("fba_fee")
  commissionRate            Decimal       @default(0.15) @map("commission_rate")
  exchangeRate              Decimal       @default(7.2) @map("exchange_rate")
  shippingCost              Decimal?      @map("shipping_cost")
  profitMargin              Decimal?      @map("profit_margin")
  profitAmount              Decimal?      @map("profit_amount")
  inventoryQuantity         Int?          @map("inventory_quantity")
  inventoryValue            Decimal?      @map("inventory_value")
  finalDecision             Decision?     @map("final_decision")
  launchDate                DateTime?     @map("launch_date")
  rejectionReason           String?       @map("rejection_reason")
  firstBatchQuantity        Int?          @map("first_batch_quantity")
  marketAnalysis            String?       @map("market_analysis")
  competitivenessAnalysis   String?       @map("competitiveness_analysis")
  alternativeSuggestions    String?       @map("alternative_suggestions")
  submitterId               String        @map("submitter_id")
  reviewerId                String?       @map("reviewer_id")
  status                    ProductStatus @default(pending_assign)
  revision                  Int           @default(1)
  submitTime                DateTime      @default(now()) @map("submit_time")
  assignTime                DateTime?     @map("assign_time")
  latestReviewTime          DateTime?     @map("latest_review_time")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  submitter                 User          @relation("Submitter", fields: [submitterId], references: [id])
  reviewer                  User?         @relation("Reviewer", fields: [reviewerId], references: [id])
  reviews                   ReviewRound[]
  objections                Objection[]
  attachments               Attachment[]
  auditLogs                 AuditLog[]

  @@index([status])
  @@index([submitterId])
  @@index([reviewerId])
  @@index([createdAt])
  @@map("products")
}

model ReviewRound {
  id                      String       @id @default(uuid())
  productId               String       @map("product_id")
  roundNumber             Int          @map("round_number")
  reviewerId              String       @map("reviewer_id")
  decision                Decision
  comment                 String
  launchDate              DateTime?    @map("launch_date")
  firstBatchQuantity      Int?         @map("first_batch_quantity")
  marketAnalysis          String?      @map("market_analysis")
  competitivenessAnalysis String?      @map("competitiveness_analysis")
  alternativeSuggestions  String?      @map("alternative_suggestions")
  improvementSuggestions  String?      @map("improvement_suggestions")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")
  editCount               Int          @default(0) @map("edit_count")
  product                 Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer                User         @relation(fields: [reviewerId], references: [id])
  objections              Objection[]
  attachments             Attachment[]

  @@unique([productId, roundNumber])
  @@index([productId, createdAt])
  @@map("review_rounds")
}

model Objection {
  id           String       @id @default(uuid())
  productId    String       @map("product_id")
  roundId      String       @map("round_id")
  submitterId  String       @map("submitter_id")
  content      String
  hasObjection Boolean      @default(true) @map("has_objection")
  createdAt    DateTime     @default(now()) @map("created_at")
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  round        ReviewRound  @relation(fields: [roundId], references: [id])
  submitter    User         @relation(fields: [submitterId], references: [id])
  attachments  Attachment[]

  @@map("objections")
}

model Attachment {
  id             String         @id @default(uuid())
  productId      String         @map("product_id")
  roundId        String?        @map("round_id")
  objectionId    String?        @map("objection_id")
  attachmentType AttachmentType @default(data_screenshot) @map("attachment_type")
  fileName       String         @map("file_name")
  filePath       String         @map("file_path")
  fileSize       Int            @map("file_size")
  fileType       String         @map("file_type")
  sha256         String
  uploaderId     String         @map("uploader_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  round          ReviewRound?   @relation(fields: [roundId], references: [id])
  objection      Objection?     @relation(fields: [objectionId], references: [id])
  uploader       User           @relation(fields: [uploaderId], references: [id])

  @@index([productId, attachmentType])
  @@map("attachments")
}

model AuditLog {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  operatorId String   @map("operator_id")
  action     String
  detail     Json
  createdAt  DateTime @default(now()) @map("created_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  operator   User     @relation(fields: [operatorId], references: [id])

  @@map("audit_log")
}

model NotificationLog {
  id          String   @id @default(uuid())
  recipientId String?  @map("recipient_id")
  channel     String   @default("internal")
  event       String
  content     String
  status      String
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  recipient   User?    @relation(fields: [recipientId], references: [id])

  @@index([createdAt])
  @@map("notification_log")
}

model LoginRateLimit {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime  @default(now()) @map("window_start")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([blockedUntil])
  @@map("login_rate_limits")
}

model Session {
  id             String   @id @default(uuid())
  tokenHash      String   @unique @map("token_hash")
  userId         String   @map("user_id")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FileCleanupTask {
  id           String   @id @default(uuid())
  relativePath String   @map("relative_path")
  reason       String
  attempts     Int      @default(0)
  lastError    String?  @map("last_error")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("file_cleanup_tasks")
}
